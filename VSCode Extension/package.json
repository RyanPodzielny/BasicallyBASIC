{
    "name": "bb",
    "displayName": "BasicallyBASIC Enhanced",
    "description": "Syntax highlighting and running BasicallyBASIC files",
    "icon": "icon128x128.png",
    "version": "1.0.0",
    "publisher": "Ryan Podzielny",
    "engines": {
        "vscode": "^1.93.0"
    },
    "categories": [
        "Programming Languages"
    ],
    "main": "./out/extension",
    "activationEvents": [
        "onCommand:runbbasic.run"
    ],
    "contributes": {
        "languages": [{
            "id": "bbasic",
            "aliases": ["BasicallyBASIC", "bbasic"],
            "extensions": [".bb"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "bbasic",
            "scopeName": "source.bb",
            "path": "./syntaxes/bbasic.tmLanguage.json"
        }],
        "commands": [
            {
                "command": "runbbasic.run",
                "title": "Run BasicallyBASIC File",
                "icon": "$(play)"
            }
        ],
        "menus": {
            "editor/title": [
                {
                    "command": "runbbasic.run",
                    "when": "resourceLangId==bbasic",
                    "group": "navigation"
                }
            ]
        }
    }
}
