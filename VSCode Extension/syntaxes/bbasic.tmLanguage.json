{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "BasicallyBASIC",
    "patterns": [
        {
            "include": "#keywords"
        },
        {
            "include": "#strings"
        },
        {
            "include": "#comments"
        },
        {
            "include": "#numbers"
        },
        {
            "include": "#operators"
        },
        {
            "include": "#identifiers"
        }
    ],
    "repository": {
        "keywords": {
            "patterns": [
                {
                    "name": "keyword.control.bbasic",
                    "match": "\\b(IF|WHILE|FOR|ELSEIF|ELSE|END|DEF|BREAK|CONTINUE|THEN|STEP|TO|RETURN)\\b"
                },
                {
                    "name": "keyword.declaration.bbasic",
                    "match": "\\b(LET)\\b"
                },
                {
                    "name": "keyword.other.bbasic",
                    "match": "\\b(TRUE|FALSE|NULL|AND|OR|NOT)\\b"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.bbasic",
            "begin": "\"",
            "end": "\"",
            "patterns": [
                {
                    "name": "constant.character.escape.bbasic",
                    "match": "\\\\."
                }
            ]
        },
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.bbasic",
                    "begin": "''",
                    "end": "''"
                },
                {
                    "name": "comment.line.bbasic",
                    "match": "'.*"
                },
                {
                    "name": "punctuation.terminator.bbasic",
                    "match": ";"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "name": "constant.numeric.integer.bbasic",
                    "match": "\\b-?\\d+\\b"
                },
                {
                    "name": "constant.numeric.float.bbasic",
                    "match": "\\b-?\\d+\\.\\d+\\b"
                }
            ]
        },
        "operators": {
            "patterns": [
                {
                    "name": "keyword.operator.comparison.bbasic",
                    "match": "(==|!=|>=|<=|<|>|=)"
                },
                {
                    "name": "keyword.operator.arithmetic.bbasic",
                    "match": "(\\+|\\-|\\*|\\/|\\^)"
                }
            ]
        },
        "identifiers": {
            "patterns": [
                {
                    "name": "entity.name.function.bbasic",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\s*\\("
                },
                {
                    "name": "variable.other.bbasic",
                    "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
                }
            ]
        }
    },
    "scopeName": "source.bb"
}